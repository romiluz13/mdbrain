{
	"name": "@mdbrain/web",
	"version": "2.0.0",
	"private": true,
	"scripts": {
		"dev": "next dev -p 3040",
		"build": "next build",
		"start": "next start -p 3040",
		"preview": "bunx opennextjs-cloudflare build && bunx wrangler dev",
		"deploy": "bunx opennextjs-cloudflare build && bunx opennextjs-cloudflare deploy",
		"check-types": "next typegen && node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@mdbrain/client": "workspace:*",
		"gsap": "3.15.0",
		"next": "^15.1.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@opennextjs/cloudflare": "^1.0.0",
		"@playwright/test": "^1.62.1",
		"@types/node": "^22.10.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.1.0",
		"typescript": "^5.8.0",
		"vitest": "^4.1.0",
		"wrangler": "^4.42.0"
	}
}
