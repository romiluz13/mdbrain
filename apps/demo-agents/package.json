{
	"name": "@mdbrain/demo-agents",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Claude role agents that work on the mdbrain demo company brain",
	"scripts": {
		"probe": "node --import tsx src/probe-haiku.ts",
		"check-types": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
		"test": "vitest run src",
		"corpus:render": "node --import tsx src/corpus/render.ts",
		"corpus:check": "node --import tsx src/corpus/check.ts",
		"seed:run": "node --import tsx src/seeding/run.ts",
		"agents:run": "node --import tsx src/agents/run.ts",
		"agents:serve": "node --import tsx src/agents/serve-cli.ts"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "2.0.109",
		"@ai-sdk/provider": "2.0.3",
		"@mdbrain/client": "workspace:*",
		"@mdbrain/lib": "workspace:*",
		"@mdbrain/mcp": "workspace:*",
		"@mdbrain/wiki-engine": "workspace:*",
		"ai": "5.0.210",
		"mongodb": "^7.0.0",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"tsx": "^4.19.0",
		"typescript": "^5.8.0",
		"vitest": "^4.1.0"
	}
}
