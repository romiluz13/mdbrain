{
	"name": "@mdbrain/wiki-engine",
	"version": "2.0.0",
	"private": false,
	"description": "MDBrain wiki engine \u2014 wiki_pages, OKF interchange, page rendering, maintenance, contradictions, governance, connectors",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/romiluz13/mdbrain.git",
		"directory": "packages/wiki-engine"
	},
	"homepage": "https://github.com/romiluz13/mdbrain#readme",
	"bugs": {
		"url": "https://github.com/romiluz13/mdbrain/issues"
	},
	"author": "Rom Iluz",
	"keywords": [
		"mdbrain",
		"wiki",
		"mongodb",
		"knowledge",
		"ai"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
