{
	"name": "@mdbrain/lib",
	"version": "2.0.0",
	"description": "Shared types and utilities for Mdbrain packages",
	"type": "module",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/romiluz13/mdbrain.git",
		"directory": "packages/lib"
	},
	"author": "Rom Iluz",
	"keywords": [
		"mdbrain",
		"runtime",
		"types",
		"utilities"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"engines": {
		"node": ">=20.19.0"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./budget": {
			"types": "./dist/budget.d.ts",
			"default": "./dist/budget.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"default": "./dist/types.js"
		},
		"./types/memory": {
			"types": "./dist/types.memory.d.ts",
			"default": "./dist/types.memory.js"
		}
	},
	"scripts": {
		"build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
		"check-types": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@ai-sdk/provider": "2.0.3",
		"ai": "5.0.210",
		"mongodb": "^7.0.0"
	},
	"devDependencies": {
		"typescript": "^5.8.0",
		"@types/node": "^22.10.0",
		"vitest": "^4.1.0",
		"zod": "3.25.76"
	},
	"homepage": "https://github.com/romiluz13/mdbrain#readme",
	"bugs": {
		"url": "https://github.com/romiluz13/mdbrain/issues"
	}
}
